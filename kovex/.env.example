# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env ne doit JAMAIS etre versionne.

# ---------------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------------
# development | production
# En production : la cle secrete devient obligatoire, l'authentification ne
# peut plus etre desactivee, et la documentation interactive est fermee.
PYGIA_ENV=development

# ---------------------------------------------------------------------------
# Securite
# ---------------------------------------------------------------------------
# Cle de signature des jetons JWT. Qui la possede peut fabriquer un jeton
# administrateur valide : elle est propre a chaque installation et ne se
# partage pas.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Obligatoire en production : l'application refuse de demarrer sans.
PYGIA_SECRET_KEY=

# Desactive TOUTE authentification. Developpement local uniquement.
# L'application refuse de demarrer si PYGIA_ENV=production et cette valeur=true.
PYGIA_AUTH_DISABLED=false

# Mot de passe du compte administrateur cree a la toute premiere initialisation,
# quand aucun fichier d'utilisateurs n'existe encore. Sans lui en production,
# aucun compte n'est cree : l'installation reste fermee. A retirer une fois la
# premiere connexion faite.
PYGIA_BOOTSTRAP_ADMIN_PASSWORD=

# Limitation de debit, active par defaut. La desactiver retire le seul frein a
# une attaque par force brute sur /auth/login.
PYGIA_RATE_LIMIT=true

# Origines autorisees par le CORS, separees par des virgules.
PYGIA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Journalisation
# ---------------------------------------------------------------------------
# DEBUG detaille les parametres de chaque mining et produit un volume important.
PYGIA_LOG_LEVEL=INFO
# text | json
PYGIA_LOG_FORMAT=text
# Chemin d'un fichier de journal. Vide = sortie standard uniquement.
PYGIA_LOG_FILE=logs/kovex.log

# Rotation du journal : au-dela de cette taille, le fichier est archive, et
# seules les dernieres archives sont conservees. Un journal en ajout continu
# sur un serveur isole finit par remplir le disque.
PYGIA_LOG_MAX_BYTES=10485760
PYGIA_LOG_BACKUPS=5

# ---------------------------------------------------------------------------
# Piste d'audit
# ---------------------------------------------------------------------------
# Emplacement de la piste d'audit des decisions de gouvernance. Vide = le
# dossier audit/ a la racine du projet. Volontairement hors des workspaces :
# supprimer un workspace ne doit pas effacer l'historique des decisions prises
# dessus. Le fichier n'est jamais reecrit, seulement complete ; toute
# modification d'une ligne existante est detectee par la verification
# d'integrite (chainage par empreinte).
PYGIA_AUDIT_FILE=

# ---------------------------------------------------------------------------
# Ports et lancement
# ---------------------------------------------------------------------------
# Port et adresse d'ecoute de l'API. Ils etaient ecrits en dur dans run_api.py,
# ce qui empechait de faire cohabiter deux instances ou de contourner un port
# deja occupe.
KOVEX_API_HOST=127.0.0.1
KOVEX_API_PORT=8000

# Adresse de l'API telle que le navigateur doit l'atteindre. Elle etait ecrite
# en dur dans frontend/js/config.js : deplacer l'API sur un autre hote ou un
# autre port obligeait a modifier un fichier livre. Laissee vide, le gabarit
# garde la valeur qu'il porte ; videz la balise du gabarit pour que
# l'interface vise sa propre origine (cas d'un relais).
# N'oubliez pas d'ajouter l'origine de l'interface a PYGIA_ALLOWED_ORIGINS.
KOVEX_API_URL=

# Port et adresse du serveur d'interface (serve_frontend.py). Celui-ci sert
# l'interface avec Cache-Control: no-store, sans quoi le navigateur resservait
# un index.html perime apres chaque livraison.
KOVEX_FRONTEND_HOST=127.0.0.1
KOVEX_FRONTEND_PORT=3000

# Rechargement automatique de l'API. Actif par defaut uniquement quand
# PYGIA_ENV=development : en exploitation, il surveille tous les fichiers du
# projet et redemarre l'API au moindre changement.
KOVEX_API_RELOAD=

# ---------------------------------------------------------------------------
# Debits par famille de requetes
# ---------------------------------------------------------------------------
# Nombre de requetes autorisees, et fenetre en secondes. Les valeurs par defaut
# conviennent a un poste d'analyste ; un serveur mutualise demande d'autres
# reglages. Les requetes preparatoires CORS ne sont jamais comptees : elles
# viennent du navigateur, pas de l'utilisateur.
#
# AUTH est volontairement bas : c'est la seule surface d'une attaque par force
# brute. Ne l'augmentez pas pour confort.
KOVEX_RATE_AUTH=5
KOVEX_RATE_AUTH_PER=60
# READ couvre la cartographie, qui emet quatre requetes par selection.
KOVEX_RATE_READ=600
KOVEX_RATE_READ_PER=60
KOVEX_RATE_DEFAULT=120
KOVEX_RATE_DEFAULT_PER=60
KOVEX_RATE_MINING=10
KOVEX_RATE_MINING_PER=60
# ASSISTANCE couvre les questions posees a un modele, pas les calculs. Le
# nommage en lot en envoie une par role candidat, a la file : un debit taille
# pour un calcul de mining les refuse toutes apres les dix premieres.
KOVEX_RATE_ASSISTANCE=60
KOVEX_RATE_ASSISTANCE_PER=60
KOVEX_RATE_EXPORT=5
KOVEX_RATE_EXPORT_PER=300

# Duree de mise en cache de la requete preparatoire CORS, en secondes. Sans
# elle le navigateur redemande l'autorisation avant chaque appel portant un
# jeton, ce qui double le nombre de requetes.
KOVEX_CORS_MAX_AGE=600

# ---------------------------------------------------------------------------
# Duree de session
# ---------------------------------------------------------------------------
# Duree maximale d'une session en minutes, renouvellements compris. Au-dela, il
# faut se reconnecter. Sans ce plafond, /auth/refresh prolongeait indefiniment
# un jeton vole : chaque appel repoussait l'echeance et rien n'y mettait fin.
#
# A savoir : changer le mot de passe d'un compte revoque immediatement tous ses
# jetons en circulation, y compris ceux qui n'ont pas expire.
KOVEX_SESSION_MAX_MINUTES=480

# ---------------------------------------------------------------------------
# Journal
# ---------------------------------------------------------------------------
# Duree a partir de laquelle une requete est consignee comme lente, en
# millisecondes. Ce n'est pas un seuil d'alerte : c'est la limite au-dela de
# laquelle un utilisateur commence a attendre. Une lenteur dont personne ne
# garde trace est une lenteur que personne ne corrige.
KOVEX_JOURNAL_LENTEUR_MS=1000

# ---------------------------------------------------------------------------
# Import de donnees
# ---------------------------------------------------------------------------
# Taille maximale d'un fichier importe, en octets. Un referentiel de 500 000
# identites pese environ 136 Mo. Rien ne bornait cette taille : tout charger en
# memoire donnait a n'importe quel compte autorise le moyen d'epuiser celle du
# serveur.
KOVEX_IMPORT_MAX_BYTES=536870912

# ---------------------------------------------------------------------------
# Cout du hachage des mots de passe
# ---------------------------------------------------------------------------
# NE PAS ABAISSER sur une installation reelle. La valeur par defaut (480 000)
# suit la recommandation OWASP pour PBKDF2-HMAC-SHA256. Ce reglage n'existe que
# pour la suite de tests, qui monte des comptes des centaines de fois.
KOVEX_PBKDF2_ITERATIONS=480000

# ---------------------------------------------------------------------------
# Annotateur semantique (facultatif, desactive par defaut)
# ---------------------------------------------------------------------------
# Propose un nom et une description pour un role decouvert. Sans adresse, il
# n'existe pas : aucune valeur par defaut n'est posee ici, parce qu'un oubli de
# configuration ferait d'un serveur d'habilitations un client reseau silencieux.
#
# Ouvrir cette sortie est une decision d'INFRASTRUCTURE. Ce qui a le droit de
# l'emprunter est une decision de l'administrateur applicatif, et se regle par
# workspace (voir docs/02-parametres.md).
#
# Le protocole vise est celui de POST {URL}/chat/completions. Un modele local
# (Ollama : http://127.0.0.1:11434/v1) ne fait sortir aucune donnee de la
# machine ; toute autre adresse en fait sortir, et le produit le signale.
# KOVEX_ANNOTATEUR_URL=http://127.0.0.1:11434/v1
# KOVEX_ANNOTATEUR_MODELE=mistral
# La cle n'est utile que pour un fournisseur distant. Elle ne quitte jamais
# l'en-tete d'autorisation : ni journalisee, ni rendue par l'API.
# KOVEX_ANNOTATEUR_CLE=
# Delai d'attente, en secondes. Un modele lent ne doit pas bloquer un ecran.
# KOVEX_ANNOTATEUR_DELAI_S=20
#
# Un point de terminaison par usage, facultatif. Le suffixe est le code de
# l'usage en majuscules. Il permet de faire tourner une question sur un petit
# modele local sans ouvrir aucune autre sortie -- ou l'inverse.
#
# Le groupe se prend entier ou pas du tout : des qu'une adresse propre est
# definie, le modele, la cle et le delai sont lus sur le meme suffixe, et
# jamais completes par les valeurs communes. Sans cela, la cle configuree pour
# un fournisseur partirait vers un autre.
# KOVEX_ANNOTATEUR_URL_NOMMAGE_DE_ROLE=http://127.0.0.1:11434/v1
# KOVEX_ANNOTATEUR_MODELE_NOMMAGE_DE_ROLE=mistral
# KOVEX_ANNOTATEUR_CLE_NOMMAGE_DE_ROLE=
# KOVEX_ANNOTATEUR_DELAI_S_NOMMAGE_DE_ROLE=20
